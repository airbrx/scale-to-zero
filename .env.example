# The deployment's own values. Copy this to .env (gitignored) and fill it in,
# or let the provisioning scripts write it: infra/provision.mjs records the
# buckets and the distribution, infra/deploy-lambda.mjs the function, and
# infra/enable-logging.mjs the log bucket. CI sets the same names as variables.
# None of these is a secret; they are kept out of the public repo because they
# belong to one deployment. The names match the admin Lambda's environment.

# Where the site lives (us-west-2 in ours)
BUCKET_REGION=us-west-2
LIVE_BUCKET=<the public site's bucket>
STAGING_BUCKET=<the private staging bucket>

# CloudFront in front of the live bucket
DISTRIBUTION_ID=<distribution id>
DISTRIBUTION_DOMAIN=<xxxx.cloudfront.net>

# The admin Lambda (its region can differ from the buckets')
LAMBDA_REGION=us-east-1
FUNCTION_NAME=stz-admin

# Google sign-in for the admin: an OAuth web client id (docs/ADMIN.md)
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# CloudFront access logs, for the admin's Stats tab
LOG_BUCKET=<log bucket>
LOG_RETENTION_DAYS=30

# Recorded by the scripts, read by nothing: what provisioning created
CERTIFICATE_ARN=
FUNCTION_URL=
